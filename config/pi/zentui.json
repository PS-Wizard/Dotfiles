{
  "colorSources": {
    "starship": "theme",
    "editor": "theme",
    "userMessages": "theme"
  },
  "separator": "pipe",
  "icons": {
    "mode": "nerd"
  },
  "features": {
    "editor": true,
    "copyFriendly": true,
    "viewportIndicators": false,
    "statusLine": true
  },
  "editorBorderColorMode": "static",
  "editorModelLabel": "name",
  "responsiveFooter": true,
  "compactFooterMaxLines": 2,
  "contextStyle": "text",
  "footerSegments": {
    "cwd": true,
    "sessionName": false,
    "runtime": false,
    "modelInfo": false,
    "context": true,
    "tokens": false,
    "time": true
  },
  "components": {
    "editor": {
      "enabled": true,
      "style": "minimalist",
      "colorSource": "terminal",
      "borderColorMode": "static",
      "modelLabel": "name",
      "viewportIndicators": false,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)"
        },
        "minimalist": {
          "pathDisplay": "compact",
          "contextFormat": "percent",
          "contextGauge": false,
          "showSessionName": true,
          "showTimer": true,
          "showCost": true,
          "showGit": true,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          }
        }
      }
    },
    "userMessages": {
      "enabled": true,
      "style": "framed-copy-friendly",
      "colorSource": "theme",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      }
    },
    "selectorBorders": {
      "enabled": false,
      "style": "zentui",
      "colorSource": "terminal"
    },
    "footer": {
      "style": "starship",
      "colorSource": "theme",
      "modelLabel": "name",
      "styles": {
        "starship": {
          "format": "",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens",
          "compactMaxLines": 2,
          "separator": "pipe",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "basename",
            "depth": 0
          },
          "segments": {
            "cwd": true,
            "sessionName": false,
            "gitBranch": true,
            "gitStatus": true,
            "gitCounts": false,
            "gitCommit": false,
            "gitMetrics": false,
            "runtime": false,
            "modelInfo": false,
            "context": true,
            "tokens": false,
            "cost": true,
            "sessionDuration": false,
            "username": false,
            "time": true,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "right",
            "placements": {},
            "colorModes": {}
          }
        }
      }
    }
  }
}
