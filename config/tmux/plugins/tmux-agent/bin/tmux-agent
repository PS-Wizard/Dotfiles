#!/usr/bin/env bash
# A tiny per-tmux-server mailbox.  Messages are data, never shell input.
set -u
umask 077

socket=${TMUX_AGENT_SOCKET:-}
pane=${TMUX_AGENT_PANE:-${TMUX_PANE:-}}
while [[ ${1:-} == --socket || ${1:-} == --pane ]]; do
  case $1 in
    --socket) socket=${2:?missing socket}; shift 2 ;;
    --pane) pane=${2:?missing pane}; shift 2 ;;
  esac
done
cmd=${1:-help}; shift || :
tmux=(tmux)
[[ -n $socket ]] && tmux+=(-S "$socket")
tm() { "${tmux[@]}" "$@"; }

fail() { printf 'tmux-agent: %s\n' "$*" >&2; exit 1; }
marker_ok() { [[ $1 =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]]; }
pane_ok() { [[ $1 =~ ^%[0-9]+$ ]]; }
id_ok() { [[ $1 =~ ^m[0-9]+-[0-9]+-[0-9]+$ ]]; }
need_pane() {
  pane_ok "$pane" || fail 'run this from a tmux pane'
  [[ $(tm display-message -p -t "$pane" '#{pane_id}' 2>/dev/null) == "$pane" ]] || fail 'pane is no longer live'
}
secure_dir() {
  local dir=$1
  if [[ -e $dir || -L $dir ]]; then
    [[ -d $dir && ! -L $dir && -O $dir ]] || fail "unsafe state directory: $dir"
  elif ! mkdir -m 700 -- "$dir" 2>/dev/null; then
    # mkdir lost an EEXIST race or failed; validate before any chmod so we
    # never chmod a path that is not an owned real directory.
    [[ -d $dir && ! -L $dir && -O $dir ]] || fail "cannot create state directory: $dir"
  fi
  chmod 700 -- "$dir" 2>/dev/null || fail "cannot secure state directory: $dir"
  [[ -d $dir && ! -L $dir && -O $dir ]] || fail "unsafe state directory: $dir"
}
init_state() {
  local pid server_pid
  pid=
  [[ ${TMUX:-} =~ ,([0-9]+), ]] && pid=${BASH_REMATCH[1]}
  server_pid=$(tm display-message -p '#{pid}' 2>/dev/null) || fail 'cannot reach tmux server'
  [[ $server_pid =~ ^[0-9]+$ ]] || fail 'invalid tmux server identity'
  [[ -z $pid ]] && pid=$server_pid
  [[ $pid == "$server_pid" ]] || fail 'tmux server identity changed'
  root=/tmp/tmux-agent-$UID
  secure_dir "$root"
  state=$root/server-$pid
  secure_dir "$state"
}
pane_dir() {
  local id=${1#%}
  printf '%s/pane-%s' "$state" "$id"
}
secure_pane_dir() {
  local dir
  dir=$(pane_dir "$1")
  secure_dir "$dir"
  printf '%s' "$dir"
}
marker_of() { tm show-options -p -v -t "$1" @agent_marker 2>/dev/null || :; }
print_message() {
  local line
  while IFS= read -r line || [[ -n $line ]]; do printf '%s\n' "$line"; done < "$1"
}
# Cursor's CLI has two PTY input bugs this works around: it drops text that
# arrives in the same input chunk as C-u, and it mis-submits when Enter trails a
# bracketed-paste terminator in the same chunk. So delivery is three separate
# input events: a lone C-u, one literal bracketed-paste sequence framing the
# read command (ESC[200~...ESC[201~), and a later separate Enter, each after a
# short foreground pause. A pane capture cannot confirm the result: Cursor
# renders its input editor off the pty, so typed text never appears in tmux
# capture-pane. This pause is a tuned constant, not a timeout knob; it is
# intentionally not configurable.
notify_pause=0.1

# One target-state check: the pane must still be the exact pane we targeted,
# alive, and not in a tmux mode (a mode would swallow the keys instead of
# feeding the process). Sets notify_err on failure. Deliberately silent about
# which caller phase ran it; callers add that context.
pane_safe() {
  local want=$1 v rpane rdead rmode
  v=$(tm display-message -p -t "$want" '#{pane_id}|#{pane_dead}|#{pane_mode}' 2>/dev/null) \
    || { notify_err='lost contact with the target pane'; return 1; }
  IFS='|' read -r rpane rdead rmode <<<"$v"
  [[ $rpane == "$want" && $rdead == 0 ]] || { notify_err='target pane is no longer live'; return 1; }
  [[ -z $rmode ]] || { notify_err='target pane entered a tmux mode'; return 1; }
}
notify_target() { # pane id -> 0 when delivered; else sets notify_err
  local tpane=$1 tid=$2 mode
  notify_err=
  notify_timeout=${TMUX_AGENT_NOTIFY_TIMEOUT:-10}
  [[ $notify_timeout =~ ^[1-9][0-9]*$ ]] || { notify_err='TMUX_AGENT_NOTIFY_TIMEOUT must be a positive integer (seconds)'; return 1; }
  # One notification per target pane at a time. The lock is process-lifetime:
  # the kernel drops it if the sender exits or is killed.
  if command -v flock >/dev/null 2>&1; then
    # Group-scoped stderr redirect: a bare 'exec fd>... 2>/dev/null' would
    # make BOTH redirections persistent and silence stderr for the process.
    { exec 9>>"$destdir/.notify-lock"; } 2>/dev/null || { notify_err="cannot open notification lock $destdir/.notify-lock"; return 1; }
    flock -w "$notify_timeout" 9 || { notify_err="another notification to this pane did not finish within ${notify_timeout}s"; return 1; }
  else
    notify_err='flock(1) is not installed; cannot serialize the notification'
    return 1
  fi
  mode=$(tm display-message -p -t "$tpane" '#{pane_mode}' 2>/dev/null) || { notify_err='cannot read target pane state'; return 1; }
  if [[ $mode == copy-mode* ]]; then
    # Copy mode swallows keys and vanilla tmux cannot inject into the pane
    # process behind it, so leave copy mode once before typing. tmux cannot
    # preserve copy mode while typing into the underlying process.
    tm copy-mode -q -t "$tpane" 2>/dev/null || { notify_err='could not leave copy mode in the target pane'; return 1; }
  fi
  # Phase 1: clear any partial prompt line with a lone kill-line key. Sending
  # C-u together with text makes Cursor drop the text, so C-u travels alone.
  if ! tm send-keys -t "$tpane" -- C-u; then
    notify_err='phase 1 (clear prompt) failed: could not send C-u to the target pane'
    return 1
  fi
  sleep "$notify_pause"
  if ! pane_safe "$tpane"; then
    notify_err="phase 1 (clear prompt) failed: ${notify_err}; no further keys were sent"
    return 1
  fi
  # Phase 2: one literal bracketed-paste sequence (ESC[200~...ESC[201~) that
  # frames only the generated read command. Cursor's CLI drops text that shares
  # an input chunk with C-u and mis-submits when Enter trails the paste
  # terminator, so the paste and the later Enter stay distinct events. The
  # message body is never sent. Cursor's input editor is invisible to tmux
  # capture-pane, so the pasted text cannot be confirmed from the pane display;
  # the saved inbox file is the fallback.
  if ! tm send-keys -t "$tpane" -l -- $'\033[200~'"tmux-agent read $tid"$'\033[201~'; then
    notify_err='phase 2 (paste command) failed: could not send the notification command to the target pane'
    return 1
  fi
  sleep "$notify_pause"
  if ! pane_safe "$tpane"; then
    notify_err="phase 2 (paste command) failed: ${notify_err}; the command may remain in the prompt and Enter was withheld"
    return 1
  fi
  # Phase 3: submit once with a later separate Enter input event. No End wake
  # event and no later retry: a second key would double-submit or feed a mode.
  # tmux cannot prove the program rendered or submitted the input; these checks
  # only reduce user-input races.
  if ! tm send-keys -t "$tpane" -- Enter; then
    notify_err='phase 3 (submit) failed: could not send Enter to the target pane; the command may remain in the prompt'
    return 1
  fi
}

case $cmd in
  mark)
    need_pane; init_state
    [[ $# -le 1 ]] || fail 'usage: tmux-agent mark NAME'
    name=${1:-}
    if [[ -z $name ]]; then
      tm set-option -p -t "$pane" -u @agent_marker
      tm display-message -t "$pane" 'Agent marker removed'
      exit
    fi
    marker_ok "$name" || fail 'marker must be lowercase [a-z0-9._-], start alphanumeric, max 64'
    while IFS='|' read -r other existing; do
      [[ $other == "$pane" || $existing != "$name" ]] || fail "marker already belongs to $other"
    done < <(tm list-panes -a -F '#{pane_id}|#{@agent_marker}')
    tm set-option -p -t "$pane" @agent_marker "$name"
    tm display-message -t "$pane" "Agent marker: $name"
    ;;
  unmark)
    need_pane; init_state
    tm set-option -p -t "$pane" -u @agent_marker
    tm display-message -t "$pane" 'Agent marker removed'
    ;;
  whoami)
    need_pane; init_state
    name=$(marker_of "$pane")
    if marker_ok "$name"; then printf '%s %s\n' "$name" "$pane"; else printf 'unmarked %s\n' "$pane"; fi
    ;;
  list)
    init_state
    current=$pane
    while IFS='|' read -r id name location command; do
      marker_ok "$name" || continue
      if [[ $id == "$current" ]]; then current_flag='*'; else current_flag=' '; fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$id" "$location" "$command" "$current_flag"
    done < <(tm list-panes -a -F '#{pane_id}|#{@agent_marker}|#{session_name}:#{window_index}.#{pane_index}|#{pane_current_command}')
    ;;
  send)
    init_state
    [[ $# -ge 1 ]] || fail 'usage: tmux-agent send MARKER [MESSAGE...]'
    destination=$1; shift
    marker_ok "$destination" || fail 'invalid marker'
    found=
    while IFS='|' read -r id name; do
      [[ $name == "$destination" ]] || continue
      [[ -z $found ]] || fail 'marker is ambiguous'
      found=$id
    done < <(tm list-panes -a -F '#{pane_id}|#{@agent_marker}')
    [[ -n $found ]] || fail 'no live pane has that marker'
    if [[ $# -gt 0 ]]; then
      message=$*
    else
      message=
      while IFS= read -r line || [[ -n $line ]]; do message+=$line$'\n'; done
    fi
    if pane_ok "$pane" && [[ $(tm display-message -p -t "$pane" '#{pane_id}' 2>/dev/null) == "$pane" ]]; then
      source_name=$(marker_of "$pane")
      marker_ok "$source_name" || source_name=$pane
    else
      source_name=unknown
    fi
    # list-panes also lists dead panes kept alive by remain-on-exit;
    # reject them before anything is saved.
    dead=$(tm display-message -p -t "$found" '#{pane_dead}' 2>/dev/null) || dead=1
    [[ $dead == 0 ]] || fail 'target pane is dead'
    destdir=$(secure_pane_dir "$found")
    TZ=UTC printf -v stamp '%(%Y-%m-%dT%H:%M:%SZ)T' -1
    printf -v id 'm%(%s)T-%s-%s%s%s' -1 "$BASHPID" "$RANDOM" "$RANDOM" "$RANDOM"
    id_ok "$id" || fail 'could not create message ID'
    file=$destdir/msg-$id
    ( set -C; { printf 'From: %s\nUTC: %s\n\n' "$source_name" "$stamp"; printf '%s' "$message"; } > "$file" ) 2>/dev/null || fail 'could not save message'
    if ! notify_target "$found" "$id"; then
      printf '%s\n' "$id"
      printf 'tmux-agent: %s\n' "$notify_err" >&2
      printf 'tmux-agent: message %s is saved in the inbox and stays pending\n' "$id" >&2
      exit 1
    fi
    printf '%s\n' "$id"
    ;;
  inbox)
    need_pane; init_state
    dir=$(pane_dir "$pane")
    if [[ ! -e $dir && ! -L $dir ]]; then exit 0; fi
    secure_dir "$dir"
    shopt -s nullglob
    for file in "$dir"/msg-*; do
      id=${file##*/msg-}
      id_ok "$id" && [[ -f $file && ! -L $file && -O $file ]] && printf '%s\n' "$id"
    done
    ;;
  read|ack)
    need_pane; init_state
    [[ $# -eq 1 ]] || fail "usage: tmux-agent $cmd ID"
    id=$1; id_ok "$id" || fail 'invalid message ID'
    dir=$(pane_dir "$pane")
    [[ -d $dir && ! -L $dir && -O $dir ]] || fail 'no inbox for this pane'
    file=$dir/msg-$id
    [[ -f $file && ! -L $file && -O $file ]] || fail 'message not found'
    if [[ $cmd == read ]]; then print_message "$file"; else rm -f -- "$file"; fi
    ;;
  prompt)
    need_pane; init_state
    old=$(marker_of "$pane")
    if marker_ok "$old"; then printf 'Marker (%s; blank unmarks): ' "$old"; else printf 'Marker (blank unmarks): '; fi
    IFS= read -r name || name=
    args=()
    [[ -n $socket ]] && args+=(--socket "$socket")
    "$0" "${args[@]}" --pane "$pane" mark "$name"
    ;;
  help|--help|-h)
    printf '%s\n' \
      'usage: tmux-agent mark NAME | unmark | whoami | list' \
      '       tmux-agent send MARKER [MESSAGE...]  # or pipe MESSAGE on stdin' \
      '       tmux-agent inbox | read ID | ack ID'
    ;;
  *) fail "unknown command: $cmd (try help)" ;;
esac
