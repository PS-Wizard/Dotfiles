{
  "layer": "top",
  "exclusive":true,
  "position": "bottom",
  "height": 30,
  "spacing": 6,
  "margin": "0 12px 0px 12px",
  "modules-left": ["clock", "custom/uptime"],
  "modules-center": ["custom/ny-countdown", "custom/time-tracker"],
  "modules-right": ["cpu", "memory", "temperature", "pulseaudio", "custom/headphones-battery", "network", "battery"],

  "clock": {
    "interval": 60,
    "format": "<b>{:%H:%M}</b>",
    "format-alt": "{:%A, %B %d, %Y}",
    "tooltip": false
  },

  "custom/uptime": {
    "exec": "awk '{d=int($1/86400);h=int(($1%86400)/3600);m=int(($1%3600)/60); printf \"%d:%02d\", h+(d*24), m}' /proc/uptime",
    "interval": 60,
    "format": "<b>{}</b>",
    "tooltip": false
  },

  "custom/ny-countdown": {
    "exec": "python3 -c \"import time;from datetime import datetime as dt;d=dt(dt.now().year+1,1,1).timestamp()-time.time();print(f'{int(d//86400)};{int(d//3600)}')\"",
    "interval": 60,
    "format": "<b>{}</b>",
    "tooltip": false
  },

  "custom/time-tracker": {
    "exec": "/home/wizard/.config/waybar/time-tracker.py",
    "interval": 1,
    "tooltip": false,
    "on-click": "/home/wizard/.config/waybar/time-tracker.py toggle",
    "on-click-right": "/home/wizard/.config/waybar/time-tracker.py reset"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C",
    "format-critical": "{temperatureC}°C",
    "interval": 5,
    "tooltip": false
  },

  "cpu": {
    "interval": 5,
    "format": "{usage}%"
  },

  "memory": {
    "interval": 5,
    "format": "{used:0.1f}G"
  },

  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰝟",
    "on-click": "pavucontrol",
    "tooltip-format": "Volume: {volume}%"
  },

  "custom/headphones-battery": {
    "exec": "upower -e 2>/dev/null | grep -m1 'headset_' | xargs -r upower -i 2>/dev/null | awk -F':[[:space:]]*' '/percentage:/{print \"󰋋 \" $2}'",
    "interval": 30,
    "tooltip": false
  },

  "network": {
    "interval": 5,
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "format-linked": "󰤩"
  },

  "battery": {
    "bat": "BAT1",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "BAT {capacity}%",
    "format-charging": "CHR {capacity}%",
    "format-plugged": "PLU {capacity}%"
  }
}
